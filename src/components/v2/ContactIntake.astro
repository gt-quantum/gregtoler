---
/**
 * V2 — conversational intake. PORT of V1's ContactSection.jsx (the 4-step
 * "typeform-style" form Greg asked for — it already existed), reskinned to V2
 * tokens and rewritten from React to ~vanilla JS.
 *
 * Steps: 1 situation (auto-advances on pick) → 2 involvement (≥1, Continue) →
 *        3 the story (≥ MIN_STORY chars, Continue) → 4 name* / email* / phone /
 *        LinkedIn + preferred contact method → send.
 * Deep-link prefill: #contact?situation=broken|build|scale|ongoing|unsure
 * (also reads plain ?situation= for the Approach pillar links).
 *
 * Submits JSON to /api/contact (existing endpoint → Slack webhook), payload shape
 * matched to src/pages/api/contact.js.
 *
 * On success the form is replaced by a confirmation. If /api/qualify (a small OpenAI model) reads the
 * submission as a genuine request for Greg's services, the booking calendar is shown
 * beneath it; otherwise a plain thank-you. The gate fails closed. Work email is
 * required — free mailboxes are blocked here and re-checked in /api/contact.
 *
 * Off-happy-path states are DESIGNED, not defaulted (see build/03-anti-ai-tells.md):
 * pending, failure with retry, success — with aria-live announcements and a
 * double-submit guard.
 */
const situations = [
  { label: "Something's broken or inefficient", value: "broken" },
  { label: "I need something built", value: "build" },
  { label: "Something works but won't scale", value: "scale" },
  { label: "I need ongoing operational support", value: "ongoing" },
  { label: "Not sure yet — something needs to change", value: "unsure" },
];
const areas = [
  "Process / workflow", "Technology / tools", "AI / automation",
  "Strategy / architecture", "People / training", "Data / reporting",
];
const MIN_STORY = 40;

// Greg's Google Calendar appointment schedule (the embed URL; Greg supplied it 2026-08-20).
// Shown only when /api/qualify approves the submission. Empty string hides the block.
const BOOKING_URL = "https://calendar.google.com/calendar/appointments/schedules/AcZssZ2N_SH9sFiGA8ndwY4TnXiAUGYBcGcvHugOt_2tge_1HFqOYC7cmrbYLtz3vyatGRCRJSJMy5Zk?gv=true";
---

<div class="v2-intake" id="v2-intake" data-step="1" data-min={MIN_STORY} data-booking={BOOKING_URL}>
  <ol class="v2-intake-steps v2-mono" aria-hidden="true">
    <li data-s="1" class="on">01</li><li data-s="2">02</li><li data-s="3">03</li><li data-s="4">04</li>
  </ol>

  <form id="v2-intake-form" novalidate>
    <!-- 1 · situation — picking one advances; no button -->
    <fieldset class="v2-step" data-step="1">
      <legend>What's going on?</legend>
      <div class="v2-sit-grid" role="radiogroup" aria-label="Your situation">
        {situations.map((s) => (
          <label class="v2-sit">
            <input type="radio" name="situation" value={s.value} />
            <span>{s.label}</span>
          </label>
        ))}
      </div>
    </fieldset>

    <!-- 2 · involvement — multi-select, at least one -->
    <fieldset class="v2-step" data-step="2" hidden>
      <legend>What does it touch?</legend>
      <p class="v2-step-hint">Pick everything that applies — at least one.</p>
      <div class="v2-chip-grid">
        {areas.map((a) => (
          <label class="v2-chip">
            <input type="checkbox" name="involvement" value={a} />
            <span>{a}</span>
          </label>
        ))}
      </div>
    </fieldset>

    <!-- 3 · the story — needs enough to be worth reading -->
    <fieldset class="v2-step" data-step="3" hidden>
      <legend>Tell me what's going on.</legend>
      <p class="v2-step-hint">A few sentences is plenty. I'll figure out the right approach.</p>
      <textarea name="message" rows="6" placeholder="What's happening, what you've tried, what good looks like…" aria-label="Your situation in a few sentences" aria-describedby="v2-intake-count"></textarea>
      <p class="v2-count v2-mono" id="v2-intake-count" aria-live="polite"></p>
    </fieldset>

    <!-- 4 · reach you -->
    <fieldset class="v2-step" data-step="4" hidden>
      <legend>Where do I reach you?</legend>
      <div class="v2-who">
        <label>Name <span class="req" aria-hidden="true">*</span><input type="text" name="name" autocomplete="name" required /></label>
        <label>Work email <span class="req" aria-hidden="true">*</span><input type="email" name="email" autocomplete="email" required inputmode="email" placeholder="you@yourcompany.com" /></label>
        <label>Phone <span class="opt">optional</span><input type="tel" name="phone" autocomplete="tel" inputmode="tel" /></label>
        <label>LinkedIn <span class="opt">optional</span><input type="url" name="linkedin" autocomplete="url" inputmode="url" placeholder="linkedin.com/in/…" /></label>
      </div>
      <div class="v2-reach" role="radiogroup" aria-label="Best way to reach you">
        <span class="v2-mono lbl">Best way to reach you <span class="opt">optional</span></span>
        <div class="v2-reach-opts">
          <label class="v2-chip"><input type="radio" name="reach" value="email" /><span>Email</span></label>
          <label class="v2-chip"><input type="radio" name="reach" value="call" /><span>Call</span></label>
          <label class="v2-chip"><input type="radio" name="reach" value="text" /><span>Text</span></label>
          <label class="v2-chip"><input type="radio" name="reach" value="linkedin" /><span>LinkedIn</span></label>
        </div>
      </div>
      <p class="v2-field-err" id="v2-intake-fielderr" role="alert" hidden></p>
    </fieldset>

    <div class="v2-intake-nav">
      <button type="button" class="v2-int-back" id="v2-int-back" hidden>Back</button>
      <button type="button" class="v2-int-next" id="v2-int-next" hidden disabled>Continue</button>
      <button type="submit" class="v2-int-send" id="v2-int-send" hidden>
        <span class="idle">Send it over</span>
        <span class="busy" hidden>Sending&hellip;</span>
      </button>
    </div>

    <p class="v2-intake-status" id="v2-intake-status" aria-live="polite"></p>
  </form>

  <!-- success replaces the form entirely -->
  <div class="v2-intake-done" id="v2-intake-done" hidden>
    <p class="v2-mono">Received</p>
    <h3>Got it. I'll read it today and reply within one business day.</h3>
    <p id="v2-intake-bookcopy" hidden>Want to skip the back-and-forth? Pick a time below and we'll talk it through.</p>
    <div class="v2-book" id="v2-intake-book" hidden>
      <iframe id="v2-intake-cal" title="Book a time with Greg" loading="lazy" src="about:blank"></iframe>
      <a class="v2-book-link" id="v2-intake-callink" href="#" target="_blank" rel="noopener noreferrer">Open the calendar in a new tab &rarr;</a>
    </div>
    <p class="v2-intake-alt">If it's time-sensitive, <a href="https://linkedin.com/in/gregtoler" target="_blank" rel="noopener noreferrer">LinkedIn</a> is the fast lane.</p>
  </div>
</div>

<style>
  .v2-intake, .v2-intake * { box-sizing: border-box; }   /* inputs at width:100% stay inside the card */
  .v2-intake {
    margin: 0 auto;   /* fills the section measure (--v2-measure) like every other row */
    border: 1px solid var(--v2-line); border-radius: var(--v2-radius);
    background: color-mix(in srgb, var(--v2-surface) 92%, transparent);
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    padding: 34px 38px 30px;
  }
  .v2-intake-steps {
    display: flex; gap: 14px; list-style: none; margin: 0 0 26px; padding: 0;
  }
  .v2-intake-steps[hidden] { display: none; }   /* display:flex would otherwise beat the hidden attribute */
  .v2-intake-steps li { opacity: .35; transition: opacity .3s, color .3s; }
  .v2-intake-steps li.on { opacity: 1; color: var(--v2-light); }
  .v2-intake-steps li.done { opacity: .7; }

  fieldset { border: 0; margin: 0; padding: 0; min-width: 0; }
  .v2-intake[data-step="1"] .v2-intake-nav { display: none; }   /* the pick advances; nothing to press */
  legend {
    font-family: var(--v2-display); font-weight: 600;
    font-size: clamp(1.2rem, 2.2vw, 1.55rem); color: var(--v2-ink);
    margin-bottom: 18px; display: flex; align-items: baseline; gap: 12px;
  }
  legend .v2-mono { color: var(--v2-light); }
  .v2-step-hint { color: var(--v2-ink-faint); font-size: 13px; margin: -10px 0 16px; }
  .req { color: var(--v2-light); }
  .opt { color: var(--v2-ink-faint); opacity: .8; text-transform: none; letter-spacing: .04em; margin-left: 6px; }

  .v2-sit-grid { display: grid; gap: 8px; }
  .v2-sit input { position: absolute; opacity: 0; pointer-events: none; }
  .v2-sit span {
    display: block; padding: 12px 16px;
    border: 1px solid var(--v2-line); border-radius: var(--v2-radius);
    color: var(--v2-ink-dim); font-size: 14.5px; cursor: pointer;
    transition: border-color .25s var(--v2-ease-out), color .25s, background .25s;
  }
  .v2-sit:hover span { color: var(--v2-ink); }
  .v2-sit input:checked + span {
    border-color: var(--v2-light); color: var(--v2-ink);
    background: var(--v2-light-soft);
  }
  .v2-sit input:focus-visible + span { outline: 2px solid var(--v2-light); outline-offset: 2px; }

  .v2-chip-grid, .v2-reach-opts { display: flex; flex-wrap: wrap; gap: 8px; }
  .v2-chip input { position: absolute; opacity: 0; pointer-events: none; }
  .v2-chip span {
    display: block; padding: 8px 14px; border-radius: 100px;
    border: 1px solid var(--v2-line); color: var(--v2-ink-dim);
    font-size: 13px; cursor: pointer;
    transition: border-color .25s var(--v2-ease-out), color .25s, background .25s;
  }
  .v2-chip:hover span { color: var(--v2-ink); }
  .v2-chip input:checked + span {
    border-color: var(--v2-light); color: var(--v2-ink); background: var(--v2-light-soft);
  }
  .v2-chip input:focus-visible + span { outline: 2px solid var(--v2-light); outline-offset: 2px; }

  textarea, .v2-who input {
    display: block; width: 100%; max-width: 100%; background: var(--v2-base);
    border: 1px solid var(--v2-line); border-radius: var(--v2-radius);
    color: var(--v2-ink); font-family: var(--v2-sans); font-size: 14.5px;
    padding: 12px 14px;
    transition: border-color .25s var(--v2-ease-out);
  }
  textarea { resize: vertical; min-height: 140px; }
  textarea:focus, .v2-who input:focus { outline: none; border-color: var(--v2-light); }
  .v2-count { margin: 8px 0 0; color: var(--v2-ink-faint); text-align: right; }
  .v2-count.ok { color: var(--v2-light); }

  .v2-who { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 18px; }
  .v2-who label { display: block; font-family: var(--v2-mono); font-size: 10px; letter-spacing: .12em; text-transform: uppercase; color: var(--v2-ink-faint); min-width: 0; }
  .v2-who label input { margin-top: 6px; }
  .v2-reach { margin-top: 18px; }
  .v2-reach .lbl { display: block; margin-bottom: 10px; }
  .v2-field-err { color: #C96B6B; font-size: 13px; margin: 12px 0 0; }

  .v2-intake-nav { display: flex; gap: 12px; margin-top: 22px; min-height: 40px; }
  .v2-int-back, .v2-int-next, .v2-int-send {
    font-family: var(--v2-mono); font-size: 11px; letter-spacing: .12em;
    text-transform: uppercase; padding: 11px 20px; border-radius: 100px;
    cursor: pointer; transition: border-color .25s, color .25s, opacity .25s;
  }
  .v2-int-back { background: none; border: 0; color: var(--v2-ink-faint); }
  .v2-int-back:hover { color: var(--v2-ink); }
  .v2-int-next, .v2-int-send {
    margin-left: auto; background: transparent;
    border: 1px solid var(--v2-line); color: var(--v2-ink);
  }
  .v2-int-next:hover:not(:disabled), .v2-int-send:hover:not(:disabled) { border-color: var(--v2-light); }
  .v2-int-next:disabled { opacity: .35; cursor: default; }
  .v2-int-send:disabled { opacity: .6; cursor: progress; }

  .v2-intake-status { margin: 14px 0 0; font-size: 13px; color: var(--v2-ink-dim); }
  .v2-intake-status:empty { display: none; }
  .v2-intake-status.err { color: #C96B6B; }

  .v2-intake-done { text-align: center; padding: 26px 0 14px; }
  .v2-intake-done .v2-mono { color: var(--v2-light); margin-bottom: 12px; }
  .v2-intake-done h3 { font-family: var(--v2-display); font-weight: 600; font-size: 1.35rem; margin: 0 0 12px; color: var(--v2-ink); }
  .v2-intake-done p { color: var(--v2-ink-dim); font-size: 14px; margin: 0; }
  .v2-intake-done a { color: var(--v2-light); }
  .v2-book { margin: 24px 0 18px; }
  .v2-book iframe { display: block; width: 100%; height: 620px; border: 1px solid var(--v2-line); border-radius: var(--v2-radius); background: #fff; }
  .v2-book-link { display: inline-block; margin-top: 10px; font-family: var(--v2-mono); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; }
  .v2-intake-alt { margin-top: 14px !important; }

  @media (max-width: 768px) {
    .v2-intake { padding: 24px 20px; }
    .v2-who { grid-template-columns: 1fr; }
    .v2-book iframe { height: 520px; }
  }
</style>

<script>
  import { isFreeEmail } from "../../lib/free-email-domains.js";
  (() => {
    const root = document.getElementById("v2-intake");
    const form = document.getElementById("v2-intake-form") as HTMLFormElement | null;
    if (!root || !form) return;

    const MIN = parseInt(root.dataset.min || "40", 10);
    const BOOKING = root.dataset.booking || "";

    const steps = Array.from(form.querySelectorAll<HTMLFieldSetElement>(".v2-step"));
    const dots = Array.from(root.querySelectorAll<HTMLElement>(".v2-intake-steps li"));
    const back = document.getElementById("v2-int-back") as HTMLButtonElement;
    const next = document.getElementById("v2-int-next") as HTMLButtonElement;
    const send = document.getElementById("v2-int-send") as HTMLButtonElement;
    const status = document.getElementById("v2-intake-status")!;
    const fieldErr = document.getElementById("v2-intake-fielderr")!;
    const count = document.getElementById("v2-intake-count")!;
    const done = document.getElementById("v2-intake-done")!;
    const story = form.elements.namedItem("message") as HTMLTextAreaElement;

    let step = 1;
    const LAST = 4;

    const storyLen = () => story.value.trim().length;

    function stepValid(): boolean {
      if (step === 1) return !!form!.querySelector('input[name="situation"]:checked');
      if (step === 2) return !!form!.querySelector('input[name="involvement"]:checked');
      if (step === 3) return storyLen() >= MIN;
      return true;
    }

    function updateCount() {
      const n = storyLen();
      const left = MIN - n;
      count.textContent = left > 0 ? `${left} more character${left === 1 ? "" : "s"} to go` : `${n} characters`;
      count.classList.toggle("ok", left <= 0);
    }

    function show() {
      steps.forEach((f) => { f.hidden = parseInt(f.dataset.step!) !== step; });
      dots.forEach((d) => {
        const n = parseInt(d.dataset.s!);
        d.classList.toggle("on", n === step);
        d.classList.toggle("done", n < step);
      });
      back.hidden = step === 1;
      next.hidden = step === 1 || step === LAST;      // step 1 advances itself; step 4 sends
      send.hidden = step !== LAST;
      next.disabled = !stepValid();
      root!.dataset.step = String(step);
      if (step === 3) updateCount();
      const first = steps[step - 1].querySelector<HTMLElement>("input, textarea");
      first?.focus({ preventScroll: true });
    }

    form.addEventListener("change", (e) => {
      next.disabled = !stepValid();
      // step 1: the pick IS the continue
      if (step === 1 && (e.target as HTMLInputElement).name === "situation" && stepValid()) {
        window.setTimeout(() => { if (step === 1) { step = 2; show(); } }, 260);
      }
    });
    story.addEventListener("input", () => { updateCount(); next.disabled = !stepValid(); });
    next.addEventListener("click", () => { if (stepValid() && step < LAST) { step++; show(); } });
    back.addEventListener("click", () => { if (step > 1) { step--; show(); } });

    // deep-link prefill: ?situation=… in query or after the #contact hash
    const q = new URLSearchParams(window.location.search);
    const hashQ = window.location.hash.includes("?")
      ? new URLSearchParams(window.location.hash.split("?")[1]) : null;
    const pre = q.get("situation") || hashQ?.get("situation");
    if (pre) {
      const input = form.querySelector<HTMLInputElement>(`input[name="situation"][value="${pre}"]`);
      if (input) { input.checked = true; step = 2; }
    }
    show();

    // submit — designed states, no default browser behaviour
    let sending = false;
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (sending) return;                       // double-submit guard

      const val = (n: string) => (form.elements.namedItem(n) as HTMLInputElement).value.trim();
      const name = val("name"), email = val("email"), phone = val("phone");
      let linkedin = val("linkedin");
      const reach = (form.querySelector<HTMLInputElement>('input[name="reach"]:checked')?.value || "email") as "email" | "call" | "text" | "linkedin";
      fieldErr.hidden = true;

      let problem = "";
      if (!name) problem = "I need a name to reply to.";
      else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) problem = "That email doesn't look right — mind checking it?";
      else if (isFreeEmail(email)) problem = "Use your work email — it's how I know who I'm talking to.";
      else if ((reach === "call" || reach === "text") && !phone) problem = `Add a phone number if you'd like me to ${reach}.`;
      else if (reach === "linkedin" && !linkedin) problem = "Add your LinkedIn URL if that's where you'd like me to reach you.";
      else if (phone && phone.replace(/\D/g, "").length < 7) problem = "That phone number looks short — mind checking it?";
      if (linkedin && !/^https?:\/\//i.test(linkedin)) linkedin = "https://" + linkedin;
      if (linkedin && !/linkedin\.com\//i.test(linkedin)) problem = problem || "That doesn't look like a LinkedIn URL.";
      if (problem) { fieldErr.textContent = problem; fieldErr.hidden = false; return; }

      sending = true;
      send.disabled = true;
      send.querySelector(".idle")!.toggleAttribute("hidden", true);
      send.querySelector(".busy")!.toggleAttribute("hidden", false);
      status.classList.remove("err");
      status.textContent = "";

      const sit = form.querySelector<HTMLInputElement>('input[name="situation"]:checked');
      const payload = {
        situation: sit ? sit.nextElementSibling!.textContent : "(not set)",
        involvement: Array.from(form.querySelectorAll<HTMLInputElement>('input[name="involvement"]:checked')).map((c) => c.value).join(", "),
        message: story.value.trim(),
        name, email, phone, linkedin,
        // api/contact.js grammar: "phone" + phoneType for call/text, "linkedin", or "email"
        contactMethod: reach === "call" || reach === "text" ? "phone" : reach,
        phoneType: reach === "call" || reach === "text" ? reach : undefined,
        source: "v2",
      };

      try {
        const res = await fetch("/api/contact", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        if (res.status === 422) {
          fieldErr.textContent = "Use your work email — it's how I know who I'm talking to.";
          fieldErr.hidden = false;
          throw new Error("422");
        }
        if (!res.ok) throw new Error(String(res.status));
        const { token } = (await res.json().catch(() => ({}))) as { token?: string };
        form.hidden = true;
        root!.querySelector(".v2-intake-steps")!.setAttribute("hidden", "");
        // Booking calendar only for submissions Claude reads as a genuine request
        // (/api/qualify). Fails closed: any hiccup = plain thank-you.
        let qualified = false;
        if (BOOKING && token) {
          try {
            const q = await fetch("/api/qualify", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ ...payload, token }) });
            qualified = q.ok && (await q.json()).qualified === true;
          } catch { qualified = false; }
        }
        if (BOOKING && qualified) {
          document.getElementById("v2-intake-bookcopy")!.hidden = false;
          const book = document.getElementById("v2-intake-book")!;
          (document.getElementById("v2-intake-cal") as HTMLIFrameElement).src = BOOKING;
          (document.getElementById("v2-intake-callink") as HTMLAnchorElement).href = BOOKING;
          book.hidden = false;
        }
        done.hidden = false;
        status.textContent = "Sent.";
      } catch {
        sending = false;
        send.disabled = false;
        send.querySelector(".idle")!.toggleAttribute("hidden", false);
        send.querySelector(".busy")!.toggleAttribute("hidden", true);
        status.classList.add("err");
        status.textContent = "That didn't go through — nothing lost, try Send again. If it keeps failing, email greg@gregtoler.com directly.";
      }
    });
  })();
</script>
