---
/**
 * Custom cursor — a ring that trails the pointer, with a hard dot at the true position.
 *
 * The ring lerps toward the pointer so it lags slightly and feels weighted; the dot never
 * lags, so precision is unaffected. Over anything interactive the ring expands and the dot
 * fades, which is the whole hover affordance.
 *
 * Safeguards:
 * - Only mounts for a fine pointer (mouse). Touch and coarse pointers keep the OS cursor.
 * - `cursor: none` is applied from JS, never in static CSS, so a JS failure can never
 *   leave someone without a pointer.
 * - Disabled entirely under prefers-reduced-motion.
 */
---

<div class="v2-cursor" id="v2-cursor" aria-hidden="true">
  <span class="ring"></span>
  <span class="dot"></span>
</div>

<style>
  .v2-cursor { display: none; }

  :root.v2-has-cursor .v2-cursor {
    display: block;
    position: fixed; left: 0; top: 0;
    pointer-events: none;
    z-index: 120;
  }
  :root.v2-has-cursor .v2-cursor .ring,
  :root.v2-has-cursor .v2-cursor .dot {
    position: absolute; left: 0; top: 0;
    border-radius: 50%;
    box-sizing: border-box;   /* border INSIDE the box — off-centre bug was the border
                                 adding 1px outside the declared size */
    will-change: transform;
  }
  :root.v2-has-cursor .v2-cursor .ring {
    width: 24px; height: 24px;
    margin: -12px 0 0 -12px;
    border: 1px solid var(--v2-light);
    opacity: .55;
    transition: width .3s var(--v2-ease-out), height .3s var(--v2-ease-out),
                margin .3s var(--v2-ease-out), opacity .3s var(--v2-ease-out),
                background-color .3s var(--v2-ease-out);
  }
  :root.v2-has-cursor .v2-cursor .dot {
    width: 4px; height: 4px;
    margin: -2px 0 0 -2px;
    background: var(--v2-light);
    opacity: .9;
    transition: opacity .25s var(--v2-ease-out), transform .25s var(--v2-ease-out);
  }

  /* over something clickable: ring opens up, dot gets out of the way */
  :root.v2-has-cursor.v2-cursor-hot .v2-cursor .ring {
    width: 38px; height: 38px; margin: -19px 0 0 -19px;
    opacity: .9;
    background: var(--v2-light-soft);
  }
  :root.v2-has-cursor.v2-cursor-hot .v2-cursor .dot { opacity: 0; }

  /* pressed */
  :root.v2-has-cursor.v2-cursor-down .v2-cursor .ring { width: 18px; height: 18px; margin: -9px 0 0 -9px; }
</style>

<script>
  (() => {
    const fine = window.matchMedia("(pointer: fine)").matches;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!fine || reduce) return;

    const wrap = document.getElementById("v2-cursor");
    if (!wrap) return;
    const ring = wrap.querySelector<HTMLElement>(".ring");
    const dot = wrap.querySelector<HTMLElement>(".dot");
    if (!ring || !dot) return;

    const root = document.documentElement;
    root.classList.add("v2-has-cursor");
    // applied from JS only — a static `cursor:none` would strip the pointer if this
    // script ever failed to run
    const style = document.createElement("style");
    style.textContent = ":root.v2-has-cursor, :root.v2-has-cursor * { cursor: none !important; }";
    document.head.appendChild(style);

    let tx = window.innerWidth / 2, ty = window.innerHeight / 2;
    let rx = tx, ry = ty;

    window.addEventListener("pointermove", (e: PointerEvent) => {
      if (e.pointerType !== "mouse") return;
      tx = e.clientX; ty = e.clientY;
      dot.style.transform = `translate(${tx}px, ${ty}px)`;
    }, { passive: true });

    const HOT = "a, button, [role='button'], input, textarea, select, label, summary";
    document.addEventListener("pointerover", (e) => {
      const t = e.target as Element | null;
      root.classList.toggle("v2-cursor-hot", !!t?.closest?.(HOT));
    }, { passive: true });

    window.addEventListener("pointerdown", () => root.classList.add("v2-cursor-down"), { passive: true });
    window.addEventListener("pointerup", () => root.classList.remove("v2-cursor-down"), { passive: true });
    document.addEventListener("mouseleave", () => { wrap.style.opacity = "0"; });
    document.addEventListener("mouseenter", () => { wrap.style.opacity = "1"; });

    (function loop() {
      rx += (tx - rx) * 0.18;   // the lag is the whole character of it
      ry += (ty - ry) * 0.18;
      ring.style.transform = `translate(${rx.toFixed(2)}px, ${ry.toFixed(2)}px)`;
      requestAnimationFrame(loop);
    })();
  })();
</script>
