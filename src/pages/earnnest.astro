  .presenter .pane { min-height: 0; display: grid; gap: 14px; align-content: start; }
  .presenter iframe { width: 100%; aspect-ratio: 16 / 9; border: 1px solid var(--line); background: var(--base); display: block; pointer-events: none; }
  .presenter .notes { font-size: 1.45rem; line-height: 1.55; color: var(--ink); max-width: 62ch; overflow-y: auto; margin: 0; text-wrap: pretty; }
