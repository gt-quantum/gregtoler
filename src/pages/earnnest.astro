  .tl.on .draw { stroke-dashoffset: 0; }
  .tl .tick { opacity: 0; transition: opacity .4s .6s; }
  .tl.on .tick { opacity: 1; }

  /* ---- modes ---- */
  body.embed .bar, body.embed .foot, body.embed .grain { display: none; }
