  const THY = [30, 42, 54, 66];

  /* every step: which slide, where the dot is ([x%, y%, size cqw]), which texts are on, and any moved texts */
  const BURST = ['t-th1', 't-h0', 't-hd0', 't-h1', 't-hd1', 't-h2', 't-hd2', 't-h3', 't-hd3'];
  const STEPS = [
    { s: 0, dots: [[50, 32, 1.4]], lit: true, show: ['t-eyebrow', 't-title', 't-seam'] },
    ...[0, 1, 2, 3].map(k => ({ s: 1, dots: [[5.5, THY[k], 1.5]], lit: true, speed: .45, tbase: .1, tstagger: .08, show: [...TH, 't-k' + k + '0', 't-k' + k + '1', 't-k' + k + '2'], cur: ['t-th' + k] })),
    { s: 1, dots: [[5.5, 22, 1.5]], lit: true, speed: .55, tbase: .25, tstagger: .07, show: BURST, cur: ['t-th1'], pos: { 't-th1': [9, 22] } },
    { s: 1, dots: [[53.5, 22, 1.5]], lit: true, speed: .55, tbase: .25, tstagger: .07, show: [...BURST, 't-why', 't-y0', 't-yd0', 't-y1', 't-yd1', 't-y2', 't-yd2'], fade: BURST, cur: ['t-th1', 't-why'], pos: { 't-th1': [9, 22] } },
    ...BRAIN.map((part, i) => ({ s: 2, dots: [[50, 47.3, 5]], brain: BRAIN.slice(0, i + 1), part, ...(i === 0 ? { intro: ['t-how-eye', 't-how', 't-seam'], introDots: [[50, 32, 1.4]], introMs: 2200 } : {}) })),
    ...TL.map((x, i) => ({ s: 3, dots: [[x, 45, 1.3]], brain: BRAIN, brainMode: 'mini', tl: i, speed: .45, tbase: .05, show: [...TL_T, 't-m' + i] })),
    { s: 4, dots: [[22, 47.6, 3]], brain: BRAIN, brainMode: 'side', show: ['t-plab', 't-d0', 't-d1', 't-d2', 't-d3', 't-d4', 't-d5', 't-d6', 't-hr', 't-n0', 't-n1'], tstagger: .05 },
    { s: 5, dots: [[50, 32, 1.4]], lit: true, qa: true },
    { s: 6, dots: [[50, 32, 1.4]], lit: true, cta: true }
  ];

  const params = new URLSearchParams(location.search);
  const IS_ADMIN = document.body.dataset.role === 'admin';
  const EMBED = params.has('embed'), PRESENTER = params.has('presenter') && IS_ADMIN;
  if (EMBED) document.body.classList.add('embed');
  if (PRESENTER) document.body.classList.add('presenting');

  const canvas = document.getElementById('canvas');
  const brain = document.getElementById('brain');
  const tl = document.getElementById('tl');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');

  document.getElementById('ticks').innerHTML = Array.from({ length: 13 }, (_, i) => {
    const x = 480 + i * (1024 / 12);
    return `<line class="tick" x1="${x}" y1="395" x2="${x}" y2="415" />`;
  }).join('');

  /* the dot pool: index 0 is the thread, the rest exist for splits */
  const POOL = 6;
  const dots = Array.from({ length: POOL }, (_, i) => {
    const el = document.createElement('div'); el.className = 'd'; el.setAttribute('aria-hidden', 'true');
    if (i === 0) el.innerHTML = '<span class="ring" aria-hidden="true"></span>';
    el.style.opacity = i === 0 ? '1' : '0';
    canvas.appendChild(el);
    return el;
  });
  const place = (el, x, y, s) => { el.style.left = x + '%'; el.style.top = y + '%'; el.style.width = s + 'cqw'; el.style.height = s + 'cqw'; };

  const texts = [...canvas.querySelectorAll('.t')];
  const HOME = {}; texts.forEach(t => HOME[t.id] = [parseFloat(t.style.left), parseFloat(t.style.top)]);
  let cur = -1, introTimer;

  function render(i, instant, back) {
    const st = STEPS[i];
    canvas.classList.toggle('still', !!st.still);
    canvas.style.setProperty('--morph', (st.speed || .8) + 's');
    document.getElementById('cta').classList.toggle('on', !!st.cta);
    document.getElementById('qa').classList.toggle('on', !!st.qa);
    if (!st.qa) closeAppx();
    clearTimeout(introTimer);
    const intro = st.intro && !instant && !back && (cur < 0 || STEPS[cur].s !== st.s);

    const dotsNow = intro && st.introDots ? st.introDots : st.dots;
    const first = dotsNow[0];
    dots.forEach((el, j) => {
      el.classList.toggle('snap', !!instant);
      const d = dotsNow[j];
      if (d) { el.style.setProperty('--dl', instant ? '0s' : (j * (st.stagger || 0)) + 's'); place(el, d[0], d[1], d[2]); el.style.opacity = 1; }
      else { el.style.setProperty('--dl', '0s'); place(el, first[0], first[1], 0); el.style.opacity = 0; }
    });
    dots[0].classList.toggle('lit', !!st.lit || !!(intro && st.introDots));

    const on = new Set(st.show || []);
    if (intro) st.intro.forEach(id => on.add(id));
    let k = 0;
    texts.forEach(t => {
      const show = on.has(t.id);
      const p = (st.pos && st.pos[t.id]) || HOME[t.id];
      if (show && !t.classList.contains('on')) t.style.setProperty('--tdl', (instant ? 0 : (st.tbase ?? .85) + (st.tstagger || 0) * k++) + 's');
      if (instant) { t.style.transition = 'none'; requestAnimationFrame(() => t.style.transition = ''); }
      t.style.left = p[0] + '%'; t.style.top = p[1] + '%';
      t.classList.toggle('on', show);
      t.classList.toggle('cur', !!(st.cur && st.cur.includes(t.id)));
      t.classList.toggle('faded', !!(st.fade && st.fade.includes(t.id)));
    });

    brain.classList.toggle('rev', !!back);
    brain.classList.toggle('on', !!st.brain);
    BRAIN.forEach(p => brain.classList.toggle('p-' + p, !!st.brain && st.brain.includes(p) && !(intro && p === st.part)));
    if (intro) introTimer = setTimeout(() => {
      st.intro.forEach(id => document.getElementById(id).classList.remove('on'));
      dots.forEach((el, j) => { el.classList.remove('snap'); const d = st.dots[j]; if (d) place(el, d[0], d[1], d[2]); });
      dots[0].classList.toggle('lit', !!st.lit);
      setTimeout(() => brain.classList.add('p-' + st.part), 500);
    }, st.introMs);
    if (st.part) brain.dataset.cur = st.part; else delete brain.dataset.cur;
    if (st.brain) { brain.classList.toggle('mini', st.brainMode === 'mini'); brain.classList.toggle('side', st.brainMode === 'side'); }
    tl.classList.toggle('on', st.tl !== undefined);
    TL.forEach((_, j) => document.getElementById('t-s' + j).classList.toggle('cur', st.tl === j));

    if (instant) {
      [brain, tl, ...brain.querySelectorAll('path, line, .n, .head, .bt, .ring, .spin'), ...tl.querySelectorAll('line')].forEach(el => {
        el.style.transition = 'none'; requestAnimationFrame(() => requestAnimationFrame(() => el.style.transition = ''));
      });
    }
  }

  /* ---- navigation ---- */
  const keys = document.getElementById('keys');
  const firstStepOf = s => STEPS.findIndex(st => st.s === s);
  SLIDES.forEach((sl, i) => {
    const k = document.createElement('button'); k.type = 'button'; k.textContent = String(i + 1).padStart(2, '0');
    k.setAttribute('aria-label', sl.name); k.addEventListener('click', () => go(firstStepOf(i)));
    keys.appendChild(k);
  });
  const chan = 'BroadcastChannel' in window && !EMBED ? new BroadcastChannel('earnnest-deck') : null;

  function go(i, { instant = false, quiet = false } = {}) {
    i = Math.max(0, Math.min(STEPS.length - 1, i));
    if (i === cur) return;
    const s = STEPS[i].s, back = i < cur;
    if (reduce.matches && !instant && cur >= 0) {
      canvas.classList.add('fading');
      setTimeout(() => { render(i, true, back); canvas.classList.remove('fading'); }, 300);
    } else render(i, instant, back);
    cur = i;
    document.getElementById('slide-name').textContent = SLIDES[s].name;
    document.getElementById('slide-count').textContent = `${s + 1} / ${SLIDES.length}`;
    keys.querySelectorAll('button').forEach((k, j) => k.classList.toggle('k-on', j === s));
    if (!EMBED) history.replaceState(null, '', `?${PRESENTER ? 'presenter&' : ''}step=${i}`);
    if (PRESENTER) updatePresenter();
    if (chan && !quiet) chan.postMessage({ step: i });
  }

  document.getElementById('next').addEventListener('click', () => go(cur + 1));
  document.getElementById('prev').addEventListener('click', () => go(cur - 1));
  const openNotes = () => window.open('/earnnest?presenter&step=' + cur, 'earnnest-presenter', 'width=1400,height=860');
  if (IS_ADMIN) document.getElementById('open-notes').addEventListener('click', openNotes);
  document.addEventListener('keydown', ev => {
    if (EMBED) return;
    if (ev.key === 'ArrowRight' || ev.key === ' ' || ev.key === 'PageDown' || ev.key === 'ArrowDown') { ev.preventDefault(); go(cur + 1); }
    else if (ev.key === 'ArrowLeft' || ev.key === 'PageUp' || ev.key === 'ArrowUp') { ev.preventDefault(); go(cur - 1); }
    else if (ev.key === 'Home') go(0);
    else if (ev.key === 'End') go(STEPS.length - 1);
    else if ((ev.key === 'n' || ev.key === 'N') && !PRESENTER && IS_ADMIN) openNotes();
  });
  if (chan) chan.onmessage = ({ data }) => {
    if (data.step !== undefined) go(data.step, { quiet: true });
    if (data.hello && !PRESENTER) chan.postMessage({ step: cur });
  };
  if (EMBED) window.addEventListener('message', ({ data }) => { if (data && data.step !== undefined) go(data.step, { instant: !!data.instant }); });

  /* ---- presenter view ---- */
  const pCur = document.getElementById('p-cur'), pNext = document.getElementById('p-next');
  const t0 = { at: Date.now() };
  function updatePresenter() {
    const s = STEPS[cur].s, nxt = Math.min(cur + 1, STEPS.length - 1);
    document.getElementById('p-name').textContent = SLIDES[s].name;
    document.getElementById('p-count').textContent = `${s + 1} / ${SLIDES.length}`;
    const sub = cur - firstStepOf(s);
    document.getElementById('p-notes').innerHTML = SLIDES[s].notes.split('\n\n').map((para, k) => {
      const html = para.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/\[[^\]]+\]/g, m => `<span class="ph">${m}</span>`);
      const stepped = /^\[Step \d/.test(para);
      return `<span class="${stepped && k !== sub ? 'off' : ''}">${html}</span>`;
    }).join('<br><br>');
    const onPara = document.querySelector('#p-notes > span:not(.off)'); if (onPara) onPara.scrollIntoView({ block: 'start', behavior: 'smooth' });
    document.getElementById('p-next-name').textContent = nxt === cur ? 'End' : SLIDES[STEPS[nxt].s].name + (STEPS[nxt].s === s ? ' (next step)' : '');
    const send = (f, msg) => f.dataset.ready ? f.contentWindow.postMessage(msg, '*') : (f.dataset.pending = JSON.stringify(msg));
    send(pCur, { step: cur });
    send(pNext, { step: nxt, instant: true });
  }
  if (PRESENTER) {
    [pCur, pNext].forEach(f => {
      f.addEventListener('load', () => { f.dataset.ready = '1'; if (f.dataset.pending) f.contentWindow.postMessage(JSON.parse(f.dataset.pending), '*'); });
      f.src = '/earnnest?embed&step=0' + (params.get('key') ? '&key=' + encodeURIComponent(params.get('key')) : '');
    });
    const clock = document.getElementById('p-clock');
    clock.addEventListener('click', () => t0.at = Date.now());
    setInterval(() => { const s = Math.floor((Date.now() - t0.at) / 1000); clock.textContent = `${String(Math.floor(s / 60)).padStart(2, '0')}:${String(s % 60).padStart(2, '0')}`; }, 1000);
  }

  /* ---- appendix panels on the discussion slide ---- */
  const qa = document.getElementById('qa'), appx = document.getElementById('appx');
  function openAppx(key) {
    appx.querySelectorAll('section').forEach(sec => sec.classList.toggle('on', sec.dataset.appx === key));
    appx.scrollTop = 0; appx.classList.add('open'); qa.classList.add('away');
  }
  function closeAppx() { appx.classList.remove('open'); qa.classList.remove('away'); }
  qa.querySelectorAll('[data-appx]').forEach(b => b.addEventListener('click', () => openAppx(b.dataset.appx)));
  document.getElementById('appx-back').addEventListener('click', closeAppx);
  document.addEventListener('keydown', ev => { if (ev.key === 'Escape' && appx.classList.contains('open')) { ev.stopImmediatePropagation(); closeAppx(); } }, true);

  /* capacity chart: one bar from x 40 to 960 is 100% of my average week. Segments in percent. */
  const TABS = {
    t12: { other: 12, earn: 40, ops: 0, flex: 0, when: 'Twelve weeks', note: 'About 15 to 20 hours a week', label: 'Earnnest project' },
    t8:  { other: 12, earn: 65, ops: 0, flex: 0, when: 'Eight weeks', note: 'Roughly 25 to 30 hours a week', label: 'Earnnest project' },
    ops: { other: 12, earn: 40, ops: 22, flex: 0, when: 'Twelve weeks', note: 'Roughly 25 to 30 hours a week combined', label: 'Earnnest project' },
    run: { other: 12, earn: 35, ops: 0, flex: 25, when: 'Month to month', note: 'Flexes with the roadmap', label: 'Ongoing execution' }
  };
  function setTab(key) {
    const t = TABS[key], X = p => 40 + 9.2 * p, W = p => 9.2 * p;
    document.querySelectorAll('#cap-tabs button').forEach(b => b.classList.toggle('on', b.dataset.tab === key));
    document.querySelectorAll('.appx .opt').forEach(o => o.classList.toggle('on', o.dataset.tab === key));
    const seg = (id, from, pct) => { const el = document.getElementById(id); el.style.x = X(from) + 'px'; el.style.width = W(pct) + 'px'; };
    const tag = (id, from, pct, show) => { const el = document.getElementById(id); el.setAttribute('x', X(from) + W(pct) / 2); el.setAttribute('opacity', show ? 1 : 0); };
    let at = 0;
    seg('cap-a', at, t.other); tag('cap-at', at, t.other, true); at += t.other;
    seg('cap-e', at, t.earn); tag('cap-et', at, t.earn, true); document.getElementById('cap-et').textContent = t.label; at += t.earn;
    seg('cap-o', at, t.ops); tag('cap-ot', at, t.ops, t.ops > 0); at += t.ops;
    seg('cap-f', at, t.flex); tag('cap-ft', at, t.flex, t.flex > 0); at += t.flex;
    document.getElementById('cap-rt').setAttribute('opacity', at < 92 ? 1 : 0);
    document.getElementById('cap-when').textContent = t.when;
    document.getElementById('cap-note').textContent = t.note;
  }
  document.querySelectorAll('#cap-tabs button').forEach(b => b.addEventListener('click', () => setTab(b.dataset.tab)));
  setTab('t12');

  /* ---- thank you form: same endpoint and Slack channel as the site intake ---- */
  const cta = document.getElementById('cta'), ctaForm = document.getElementById('cta-form');
  document.getElementById('cta-go').addEventListener('click', () => { cta.classList.add('open'); ctaForm.querySelector('input').focus(); });
  ctaForm.addEventListener('submit', async ev => {
    ev.preventDefault();
    const f = new FormData(ctaForm);
    if (!ctaForm.reportValidity()) return;
    cta.classList.remove('error');
    const payload = {
      source: 'earnnest-deck', name: f.get('name'), email: f.get('email'), contactMethod: 'email',
      situation: 'Earnnest: ready to get started', involvement: 'Knowledge brain, 12 weeks, $42,000 fixed',
      message: `Preferred start: ${f.get('start') || '(not given)'}${f.get('note') ? '\n' + f.get('note') : ''}`
    };
    try {
      const res = await fetch('/api/contact', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
      if (!res.ok) throw new Error(res.status);
      cta.classList.add('sent');
    } catch (e) { cta.classList.add('error'); }
  });
  document.addEventListener('keydown', ev => { if (ev.target.closest('input, textarea')) ev.stopImmediatePropagation(); }, true);

  go(+(params.get('step') || 0), { instant: true, quiet: true });
  if (chan && PRESENTER && !params.has('step')) chan.postMessage({ hello: true });
</script>
  </body>
</html>
