  var NW=172, NH=66, GX=64, GY=16, PAD=22;
  function esc(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}
  function wrapText(s,max){ var w=s.split(' '),lines=[],cur=''; w.forEach(function(x){ if((cur+' '+x).trim().length>max){lines.push(cur.trim());cur=x;} else cur=(cur+' '+x); }); if(cur.trim())lines.push(cur.trim()); return lines.slice(0,2); }
  function render(spec){
    var cols=spec.cols, ncol=cols.length;
    var maxRows=Math.max.apply(null,cols.map(function(c){return c.length;}));
