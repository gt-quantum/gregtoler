      A.forEach(function(p,i){ B.forEach(function(q,j){ var dim=cols[b][j].dim; var x1=p.x+NW,y1=p.y+NH/2,x2=q.x,y2=q.y+NH/2; var mx=(x1+x2)/2;
        out+='<path d="M'+x1+' '+y1+' C'+mx+' '+y1+' '+mx+' '+y2+' '+x2+' '+y2+'" fill="none" stroke="'+ACC+'" stroke-width="1.5" marker-end="url(#ar)"'+(dim?' stroke-dasharray="4 4"':'')+'/>'; }); });
      if(label){ var ay=(A.length===1?A[0].y+NH/2:PAD+((maxRows*NH+(maxRows-1)*GY))/2); var by=(B.length===1?B[0].y+NH/2:ay); var lx=A[0].x+NW+GX/2, ly=Math.min(ay,by)-11; if(A.length>1||B.length>1) ly=12;
        out+='<text x="'+lx+'" y="'+ly+'" text-anchor="middle" font-size="11.5" fill="currentColor" opacity=".85">'+esc(label)+'</text>'; }
    });
    // nodes
    cols.forEach(function(c,ci){ c.forEach(function(n,ri){ var p=pos[ci][ri];
      out+='<rect x="'+p.x+'" y="'+p.y+'" width="'+NW+'" height="'+NH+'" rx="6" fill="var(--v2-surface)" stroke="currentColor" stroke-width="1.2"'+(n.dim?' stroke-dasharray="4 4" opacity=".75"':'')+'/>';
      if(n.icon&&!ICONS[n.icon]){ out+='<circle cx="'+(p.x+16)+'" cy="'+(p.y+16)+'" r="9" fill="'+ACC+'"/><text x="'+(p.x+16)+'" y="'+(p.y+20)+'" text-anchor="middle" font-size="10" font-weight="700" fill="#fff">'+esc(n.icon[0].toUpperCase())+'</text>'; }
      if(n.icon&&ICONS[n.icon]){ out+='<rect x="'+(p.x+6)+'" y="'+(p.y+6)+'" width="20" height="20" rx="4" fill="#fff" stroke="none"/><image href="'+ICONS[n.icon]+'" x="'+(p.x+8)+'" y="'+(p.y+8)+'" width="16" height="16" preserveAspectRatio="xMidYMid meet"/>'; }
      var tl=wrapText(n.t,n.icon?18:22); var baseY=p.y+(n.s?20:(tl.length>1?26:38));
      tl.forEach(function(line,li){ out+='<text x="'+(p.x+NW/2)+'" y="'+(baseY+li*15)+'" text-anchor="middle" font-size="13.5" font-weight="600" fill="currentColor">'+esc(line)+'</text>'; });
      if(n.s){ var sl=wrapText(n.s,30); sl.forEach(function(line,li){ out+='<text x="'+(p.x+NW/2)+'" y="'+(baseY+tl.length*15-1+li*13)+'" text-anchor="middle" font-size="11" fill="currentColor" opacity=".7">'+esc(line)+'</text>'; }); }
    }); });
    // extra row (f01 update pass)
    if(spec.extra){ var ey=H-PAD-NH; out+='<text x="'+PAD+'" y="'+(ey-12)+'" font-size="11.5" fill="currentColor" opacity=".7">Update pass, same label</text>';
      spec.extra.forEach(function(n,i){ var x=PAD+i*(NW+GX);
        if(i>0){ out+='<path d="M'+(x-GX)+' '+(ey+NH/2)+' L'+x+' '+(ey+NH/2)+'" stroke="'+ACC+'" stroke-width="1.5" marker-end="url(#ar)"/>'; }
        out+='<rect x="'+x+'" y="'+ey+'" width="'+NW+'" height="'+NH+'" rx="6" fill="var(--v2-surface)" stroke="currentColor" stroke-width="1.2" stroke-dasharray="4 4"/>';
