    }
    out+='</svg>'; return out;
  }
  document.querySelectorAll('figure.flow[data-flow]').forEach(function(f){ var spec=FLOWS[f.getAttribute('data-flow')]; if(!spec) return; var cap=f.querySelector('figcaption'); var d=document.createElement('div'); d.style.overflowX='auto'; d.innerHTML=render(spec); var svg=d.querySelector('svg'); if(cap&&svg) svg.setAttribute('aria-label', cap.textContent); f.insertBefore(d, cap); });
