---
/**
 * gregtoler.com — HOME (2026-09-02).
 *
 * The splash hero now opens a full page: hero and framework map (HeroFramework),
 * About, Work, Contact. Ported from the `staging` V2 page, minus Approach (parked),
 * minus the proof/quotes block, minus the About variant B, minus the legal pages
 * (they do not exist on main yet).
 *
 * The V1 home is parked at `src/pages/_v1-home.astro` (the underscore keeps it out
 * of routing). The V1 sub-pages still exist but nothing links to them from here.
 *
 * "Work with me" in the hero scrolls to #contact, where the intake lives. The
 * `#contact?situation=` deep-link prefill in ContactIntake still works.
 */
import V2Layout from "../layouts/V2Layout.astro";
import HeroFramework from "../components/v2/HeroFramework.astro";
import GTMark from "../components/v2/GTMark.astro";
import SpineNav from "../components/v2/SpineNav.astro";
import ContactIntake from "../components/v2/ContactIntake.astro";
import { examples, QUADRANTS, GROUPS } from "../lib/examples";

const LINKEDIN = "https://www.linkedin.com/in/gregtoler";
---

<V2Layout
  title="Greg Toler — Go-to-Market and Operations Support"
  description="GT Strategies. Go-to-market and operations support for growing companies: strategy, systems, and hands-on execution from Greg Toler."
  robots="index, follow"
>
  <a class="v2-skip" href="#main">Skip to content</a>

  <header class="v2-head">
    <a class="v2-brand" href="/" aria-label="Greg Toler, GT Strategies">
      <GTMark height={40} />
    </a>
    <SpineNav />
    <!-- day/night parked: dark-only for now. The theme mechanism stays in the code. -->
    <a
      class="v2-linkedin"
      href={LINKEDIN}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Greg Toler on LinkedIn"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
      </svg>
    </a>
  </header>

  <main id="main">
    <!-- id lives on this wrapper: the stage keeps its own id for its scroll JS, and the
         nav needs a real #framework target spanning the whole pinned section -->
    <div id="framework">
      <HeroFramework />
    </div>

    <!-- 02 · ABOUT — the plain headshot treatment (variant A on staging) -->
    <section class="v2-wrap v2-sec v2-about-a" id="about" aria-label="About">
      <div class="v2-about-grid">
        <div class="v2-portrait">
          <img src="/images/v2/headshot.jpg" alt="Greg Toler" width="1200" height="900" loading="lazy" decoding="async" />
        </div>
        <div>
          <span class="v2-mono v2-aidx">About</span>
          <h2 class="v2-ah2">I build the systems that help businesses run.</h2>
          <div class="v2-abio">
            <p>I help B2B companies build the systems, processes, and tooling that turn
            strategy into execution. I work at the intersection of go-to-market and
            operations, covering both the revenue and operating sides of a business.</p>
            <p>I prefer to be hands-on, identifying and solving problems rather than just
            advising. That might mean creating sales models, designing GTM programs,
            building internal tools and automations, training and integrating AI, or
            finding operational efficiencies. I love solving problems and helping
            companies build, fix, or scale their systems.</p>
          </div>
        </div>
      </div>
      <div class="v2-proof">
        <p class="v2-mono lbl">Brands I've worked with</p>
        <div class="v2-logoscroll">
          <div class="v2-logotrack">
            {[0,1].map((dup) => (
              <div class="v2-logoset" aria-hidden={dup === 1 ? "true" : undefined}>
                <img src="/images/brands/state-farm.svg" alt={dup ? "" : "State Farm"} />
                <img src="/images/brands/siemens.svg" alt={dup ? "" : "Siemens"} class="sm" />
                <img src="/images/brands/BambooHR_logo.svg.png" alt={dup ? "" : "BambooHR"} />
                <img src="/images/brands/certifid.svg" alt={dup ? "" : "CertifID"} />
                <img src="/images/brands/nrev.svg" alt={dup ? "" : "nrev.ai"} />
                <img src="/images/brands/medix.svg" alt={dup ? "" : "Medix"} />
                <img src="/images/brands/sayers.svg" alt={dup ? "" : "Sayers"} />
                <span class="v2-logotext">CRC Group</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 03 · WORK — every example, plotted, linking into /examples -->
    <section class="v2-wrap v2-sec" id="work" aria-label="Work">
      <header class="v2-sec-head">
        <span class="v2-mono idx">Work</span>
        <h2>Examples of the work</h2>
        <p class="v2-sec-sub">Every example plots onto the map above. Companies are described, not named.</p>
      </header>

      <table class="v2-worktable">
        <thead class="v2-sr-only">
          <tr>
            <th scope="col">Example</th>
            <th scope="col">Kind of work</th>
            <th scope="col">Position on the map</th>
          </tr>
        </thead>
        <tbody>
          {examples.map((e, i) => (
            <tr class="v2-workrow" style={`--i:${i}`}>
              <td class="wtitle">
                <span class="wdot" aria-hidden="true"></span>
                <a href={`/examples#${e.slug}`}>{e.title}</a>
              </td>
              <td class="v2-mono wgroup">{GROUPS[e.group]}</td>
              <td class="v2-mono wcoord">{QUADRANTS[e.quadrant].coord}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <p class="v2-worknote">
        <a href="/examples">All examples, with diagrams and screenshots &rarr;</a>
      </p>
    </section>

    <!-- 04 · CONTACT — the single form; every contact link on the page targets this -->
    <section class="v2-wrap v2-sec" id="contact" aria-label="Contact">
      <header class="v2-sec-head center">
        <span class="v2-mono idx">Contact</span>
        <h2>Tell me what's going on.</h2>
        <p class="v2-sec-sub">Four quick steps' worth of context, then it's in my inbox.</p>
      </header>
      <ContactIntake />
    </section>
  </main>

  <footer class="v2-foot" aria-label="Site footer">
    <div class="v2-wrap v2-foot-in">
      <div class="v2-foot-brand">
        <GTMark height={26} />
        <p class="v2-foot-tag">Strategy and execution across go-to-market and operations.</p>
        <a class="v2-foot-mail" href="mailto:greg@gregtoler.com">greg@gregtoler.com</a>
      </div>
      <nav class="v2-foot-nav" aria-label="Footer">
        <a href="#framework">Framework</a>
        <a href="#about">About</a>
        <a href="#work">Work</a>
        <a href="#contact">Contact</a>
        <a href="/examples">Examples</a>
      </nav>
      <nav class="v2-foot-nav" aria-label="Elsewhere">
        <a href={LINKEDIN} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      </nav>
    </div>
    <div class="v2-wrap v2-foot-base">
      <span class="v2-mono">&copy; {new Date().getFullYear()} GT Strategies &middot; Greg Toler</span>
      <span class="v2-mono">Yes, I built this website.</span>
    </div>
  </footer>
</V2Layout>

<style>
  /* logo marquee, sits under the bio inside About (ported from staging's proof section) */
  .v2-proof { text-align: center; margin-top: 88px; }
  .v2-proof .lbl { color: var(--v2-light); margin: 0 0 26px; }
  .v2-logoscroll { overflow: hidden; -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  .v2-logotrack { display: flex; width: max-content; animation: v2marquee 42s linear infinite; }
  .v2-logoscroll:hover .v2-logotrack { animation-play-state: paused; }
  @keyframes v2marquee { to { transform: translateX(-50%); } }
  .v2-logoset { display: flex; align-items: center; gap: 64px; padding-right: 64px; }
  .v2-logoset img { height: 22px; width: auto; filter: brightness(0) invert(0.85); opacity: .5; transition: opacity .3s var(--v2-ease-out); }
  .v2-logoset img.sm { height: 15px; }
  .v2-logoset img:hover { opacity: .85; }
  .v2-logotext { font-size: 14px; font-weight: 500; color: var(--v2-ink-dim); opacity: .6; white-space: nowrap; }
  @media (prefers-reduced-motion: reduce) { .v2-logotrack { animation: none; } }
  @media (max-width: 768px) { .v2-proof { margin-top: 56px; } .v2-logoset { gap: 40px; padding-right: 40px; } }

  /* ---------- header ---------- */
  .v2-head {
    position: fixed; top: 0; left: 0; right: 0; z-index: 60;
    display: flex; align-items: center; justify-content: space-between;
    padding: 22px 40px;
    background: transparent;
    gap: 36px;
  }
  /* blur layer: taller than the header, faded out with a mask so there is no hard
     bottom edge where the blur stops */
  .v2-head::before {
    content: ""; position: absolute; left: 0; right: 0; top: 0;
    height: 150%;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 55%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 0%, #000 55%, transparent 100%);
    pointer-events: none;
    z-index: -1;
  }

  /* Softened: solid shapes outshout the thin mono nav. Opacity lives on the WRAPPER —
     .v2-gtmark is scoped inside the GTMark component, so a page-scoped rule targeting
     it never matches. */
  .v2-brand {
    display: flex; align-items: center; padding: 4px; position: relative;
    opacity: .72; transition: opacity .3s var(--v2-ease-out);
  }
  .v2-brand:hover { opacity: .95; }

  .v2-linkedin {
    display: flex; align-items: center; flex: none;
    padding: 8px;
    color: var(--v2-ink-dim);
    opacity: .65;               /* solid glyph vs thin mono nav text — needs the handicap */
    transition: color .25s var(--v2-ease-out), opacity .25s var(--v2-ease-out);
  }
  .v2-linkedin:hover { color: var(--v2-ink); opacity: .95; }

  /* Small screens: the vertical spine occupies a fixed rail on the LEFT, under the
     logo — V1's sidebar layout. Content pads off it; LinkedIn sits at the rail's foot
     under a divider. */
  @media (max-width: 860px) {
    main { padding-left: var(--v2-rail); }
    .v2-head { padding: 16px 20px 16px 30px; }
    .v2-linkedin {
      position: fixed;
      left: calc(var(--v2-rail-x) + var(--v2-rail-w) / 2 - 17px);
      bottom: calc(24px + env(safe-area-inset-bottom, 0px));
      z-index: 70;
      padding: 7px;
    }
    .v2-linkedin svg { width: 22px; height: 22px; }
    .v2-linkedin::before {
      content: ""; position: absolute;
      top: -10px; left: 50%; transform: translateX(-50%);
      width: 30px; height: 1px; background: var(--v2-line);
    }
  }

  /* ---------- shared section chrome — the hero/framework's own grammar:
       centred compositions, a glowing seam-rule, mono coordinates ---------- */
  .v2-sec { padding-top: 72px; padding-bottom: 72px; }
  .v2-about-a.v2-sec { padding-bottom: 28px; }
  /* the MAIN section boundaries breathe: real distance before Work and before Contact */
  #work.v2-sec { padding-top: 128px; }
  #contact.v2-sec { padding-top: 128px; }
  /* Option A's portrait is a wide image with negative margins on small screens and
     overflows any viewport under ~900px without this clip. */
  .v2-about-a { overflow: hidden; }
  /* Sections sit in the framework's centred column (--v2-measure, 880px), not the full
     wrap — the hero and plane are ~800px centred and the rest matches.
     .v2-wrap is content-box, so its 32px side padding sits outside this. KEEP. */
  .v2-sec { max-width: var(--v2-measure); }
  .v2-sec-head { margin-bottom: 56px; text-align: center; }
  .v2-sec-head .idx { color: var(--v2-light); display: block; margin-bottom: 12px; }
  .v2-sec-head h2 {
    font-family: var(--v2-display); font-weight: 600;
    font-size: clamp(1.7rem, 3.4vw, 2.7rem); line-height: 1.1;
    margin: 0 auto; color: var(--v2-ink); max-width: 24ch;
  }
  /* the seam, quoted: a centred glowing rule under every section title */
  .v2-sec-head::after {
    content: ""; display: block;
    width: 140px; height: 1px; margin: 26px auto 0;
    background: var(--v2-light);
    box-shadow: 0 0 6px 0 var(--v2-light-soft), 0 0 22px 2px var(--v2-light-soft);
  }
  .v2-sec-sub { color: var(--v2-ink-dim); margin: 16px 0 0; font-size: 15px; }

  /* ---------- 02 about ---------- */
  .v2-aidx { color: var(--v2-light); display: block; margin-bottom: 10px; }
  .v2-ah2 {
    font-family: var(--v2-display); font-weight: 600; font-size: 2.3rem; line-height: 1.1;
    margin: 0 0 44px; max-width: 24ch; color: var(--v2-ink); text-align: left;
  }
  .v2-abio p { color: var(--v2-ink-dim); font-size: 15.5px; line-height: 1.7; margin: 0 0 18px; max-width: 58ch; }
  .v2-about-a .v2-about-grid { display: grid; grid-template-columns: 340px minmax(0, 1fr); gap: 36px; align-items: center; }
  /* Plain headshot: no background removal, no bleed — the photo sits in its column,
     softly rounded, greyscaled into the palette. */
  .v2-about-a .v2-portrait img {
    display: block; width: 100%; height: auto;
    border-radius: 6px;
    border: 1px solid color-mix(in srgb, var(--v2-line) 60%, transparent);
    filter: grayscale(1) contrast(1.02) brightness(.96);
    opacity: .92;
  }
  @media (max-width: 860px) {
    .v2-about-a .v2-about-grid { grid-template-columns: 1fr; gap: 0; }
    .v2-ah2 { font-size: 1.9rem; }
    .v2-about-a .v2-portrait img { width: 100%; max-width: 420px; margin: 0 auto; }
    .v2-about-a .v2-portrait { margin-bottom: 30px; }
  }

  /* ---------- 03 work: the examples table ----------
     Semantic table, styled as the V2 rows: thin lines, mono coordinates, a pulse dot
     on hover. The whole row is the link (the anchor's ::after covers the row). */
  .v2-sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap;
  }
  .v2-worktable {
    width: 100%; border-collapse: collapse; table-layout: auto;
    border-top: 1px solid var(--v2-line);
  }
  .v2-workrow {
    position: relative;
    border-bottom: 1px solid var(--v2-line);
    color: var(--v2-ink-dim); font-size: 15px;
    transition: background .35s;
  }
  .v2-workrow td { padding: 20px 6px; vertical-align: baseline; }
  .v2-workrow .wtitle {
    display: flex; align-items: baseline; gap: 18px;
    transition: padding-left .35s var(--v2-ease-out);
  }
  .v2-workrow:hover { background: linear-gradient(90deg, var(--v2-light-soft), transparent 45%); }
  .v2-workrow:hover .wtitle { padding-left: 14px; }
  .v2-workrow .wdot {
    align-self: center; flex: none; width: 4px; height: 4px; border-radius: 50%;
    background: var(--v2-light);
    box-shadow: 0 0 0 2px var(--v2-light-soft), 0 0 10px 2px var(--v2-light);
  }
  .v2-workrow .wtitle a { color: inherit; transition: color .3s var(--v2-ease-out); }
  .v2-workrow:hover .wtitle a, .v2-workrow:focus-within .wtitle a { color: var(--v2-ink); }
  /* the row is the hit area */
  .v2-workrow .wtitle a::after { content: ""; position: absolute; inset: 0; }
  .v2-workrow .wgroup { color: var(--v2-ink-faint); white-space: nowrap; }
  .v2-workrow .wcoord { color: var(--v2-light); opacity: .8; white-space: nowrap; text-align: right; }
  .v2-workrow:hover .wdot { animation: v2pulse 1.6s var(--v2-ease-io) infinite; }
  @keyframes v2pulse {
    0%, 100% { box-shadow: 0 0 0 2px var(--v2-light-soft), 0 0 10px 2px var(--v2-light); }
    50% { box-shadow: 0 0 0 5px var(--v2-light-soft), 0 0 18px 5px var(--v2-light); }
  }
  @media (prefers-reduced-motion: reduce) {
    .v2-workrow:hover .wdot { animation: none; }
  }
  .v2-worknote { margin: 22px 0 0; text-align: center; }
  .v2-worknote a {
    font-family: var(--v2-mono); font-size: 10.5px; letter-spacing: .12em;
    text-transform: uppercase; color: var(--v2-ink-dim);
    transition: color .25s var(--v2-ease-out);
  }
  .v2-worknote a:hover { color: var(--v2-light); }
  /* phones: title and coordinate only */
  @media (max-width: 640px) {
    .v2-worktable .wgroup { display: none; }
    .v2-workrow td { padding: 16px 4px; }
    .v2-workrow .wtitle { gap: 14px; }
    .v2-workrow .wcoord { font-size: 9.5px; }
  }

  /* ---------- 04 contact ---------- */
  #contact .v2-sec-head { margin-bottom: 34px; }

  /* ---------- footer ---------- */
  /* no top rule — a full-bleed hairline over the drifting silk read as a stray line
     above the footer. The spacing alone does the separating. */
  .v2-foot { margin-top: 40px; padding: 64px 0 28px; }
  .v2-foot-in {
    max-width: var(--v2-measure);
    display: grid; grid-template-columns: minmax(0, 1.6fr) auto auto; gap: 48px 72px; align-items: start;
  }
  .v2-foot-brand { opacity: .9; }
  .v2-foot-brand :global(.v2-gtmark) { opacity: .72; }
  .v2-foot-tag { color: var(--v2-ink-dim); font-size: 14px; margin: 16px 0 10px; max-width: 34ch; }
  .v2-foot-mail { font-family: var(--v2-mono); font-size: 11px; letter-spacing: .1em; color: var(--v2-light); }
  .v2-foot-nav { display: flex; flex-direction: column; gap: 12px; }
  .v2-foot-nav a {
    font-family: var(--v2-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase;
    color: var(--v2-ink-dim); transition: color .25s var(--v2-ease-out);
  }
  .v2-foot-nav a:hover { color: var(--v2-ink); }
  .v2-foot-base {
    max-width: var(--v2-measure);
    display: flex; justify-content: space-between; gap: 20px; flex-wrap: wrap;
    border-top: 1px solid var(--v2-line-soft); margin-top: 48px; padding-top: 22px;
  }
  @media (max-width: 768px) {
    .v2-foot { padding: 48px 0 calc(24px + 60px); }   /* clears the rail's LinkedIn foot */
    .v2-foot-in { grid-template-columns: 1fr 1fr; gap: 32px; }
    .v2-foot-brand { grid-column: 1 / -1; }
  }

  /* ---------- sections on phones: V1's density ---------- */
  @media (max-width: 768px) {
    .v2-sec { padding-top: 64px; padding-bottom: 64px; }   /* .v2-wrap owns the sides */
    .v2-sec-head { margin-bottom: 30px; }
    #work.v2-sec, #contact.v2-sec { padding-top: 96px; }
  }

  /* Mobile footer vs the fixed rail: belt AND suspenders. The SpineNav script pushes
     the rail up as the footer arrives; this rule guarantees the footer also PAINTS
     ABOVE the rail with a solid ground, so the nav can never show through it even if
     a frame is dropped. */
  @media (max-width: 860px) {
    .v2-foot {
      position: relative; z-index: 80;      /* rail + LinkedIn sit at 70 */
      background: color-mix(in srgb, var(--v2-base) 90%, transparent);
      backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    }
  }
</style>

<script>
  // dark-only: clear any stored day preference so nobody is stuck in the parked theme
  document.documentElement.removeAttribute("data-v2-theme");
  try { localStorage.removeItem("v2-theme"); } catch (e) {}

  // accent audition retired — clear any stored pick so the locked token wins
  try { localStorage.removeItem("v2-accent"); } catch (e) {}
</script>
