  .start p:not(.tag) { margin: 0; color: var(--ink-dim); font-size: .92rem; line-height: 1.5; text-wrap: pretty; }
  .start { text-align: center; }

  /* ---- slide 05: the department, people to technology ---- */
  .lens .l1 { border-color: var(--light); background: color-mix(in srgb, var(--light) 16%, transparent); }
