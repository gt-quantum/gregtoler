  .gate-item small { color: var(--ink-dim); font-size: .85rem; line-height: 1.4; text-wrap: pretty; }

  /* ---- slide 08: the site's own intake, dropped in ---- */
  .intake-host { width: 100%; text-align: left; font-family: var(--sans); }
