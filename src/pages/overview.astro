  .fnode.lit { border-color: var(--light); background: color-mix(in srgb, var(--light) 16%, transparent); }
  .link-next { margin-top: 18px; }
  @media print { button.fnode .go, .link-next { display: none; } }

  /* ---- slide 06: the four As and what each one has to improve ---- */
  .gate { width: min(100%, 1180px); margin-top: 26px; padding-top: 20px; border-top: 1px solid var(--line); display: grid; gap: 12px; justify-items: center; }
  .gate-row { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12px; width: 100%; }
