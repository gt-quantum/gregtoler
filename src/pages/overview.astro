      <a class="more mono" href="https://gregtoler.com/examples" target="_blank" rel="noopener noreferrer">Sixteen worked examples at gregtoler.com/examples &rarr;</a>
    </section>

    <!-- 04 how people work with me -->
    <section class="slide" data-name="How people work with me">
      <p class="eyebrow mono">How people work with me</p>
      <h2>Bottom-up or top-down</h2>
      <div class="ways">
        <div class="way">
          <svg viewBox="0 0 100 100" aria-hidden="true" class="net">
