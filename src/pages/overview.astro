  .sit-grid, .chip-grid { display: flex; flex-wrap: wrap; gap: 6px; }
  .chip { position: relative; cursor: pointer; }
  .chip input { position: absolute; opacity: 0; inset: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; }
  .chip span {
    display: inline-block; border: 1px solid var(--line); border-radius: 100px; padding: 6px 12px;
    font-size: .85rem; color: var(--ink-dim); background: color-mix(in srgb, var(--surface) 85%, transparent);
    transition: border-color .25s, color .25s, background .25s;
  }
  .chip:hover span { border-color: var(--light); color: var(--ink); }
  .chip input:checked + span { border-color: var(--light); color: var(--ink); background: var(--light-soft); }
  .chip input:focus-visible + span { outline: 2px solid var(--light); outline-offset: 2px; }
  .intake textarea, .intake input[type="text"], .intake input[type="email"], .intake input[type="tel"], .intake input[type="url"] {
    width: 100%; font: inherit; font-size: .92rem; color: var(--ink); background: color-mix(in srgb, var(--base) 70%, transparent);
    border: 1px solid var(--line); border-radius: 2px; padding: 8px 10px; transition: border-color .25s;
  }
  .intake textarea:focus, .intake input:focus { outline: none; border-color: var(--light); }
  .intake textarea { resize: vertical; min-height: 64px; }
  .who { display: grid; grid-template-columns: 1fr 1fr; gap: 8px 12px; margin-bottom: 10px; }
  .who label { display: grid; gap: 3px; font-family: var(--mono); font-size: 9px; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-faint); }
  .req { color: var(--light); }
  .opt { color: var(--ink-faint); opacity: .7; text-transform: none; letter-spacing: 0; font-family: var(--sans); font-size: 11px; }
  .reach { display: grid; gap: 6px; }
  .field-err { margin: 0 0 8px; color: #C48A7A; font-size: .9rem; }
  .intake-nav { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
