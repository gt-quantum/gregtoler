---
/**
 * V2 preview route. V1 stays live and untouched until cutover.
 * Scope right now: hero → framework morph only. See v2/START-HERE.md.
 */
import V2Layout from "../../layouts/V2Layout.astro";
import HeroFramework from "../../components/v2/HeroFramework.astro";
import GTMark from "../../components/v2/GTMark.astro";
import SpineNav from "../../components/v2/SpineNav.astro";
import ContactIntake from "../../components/v2/ContactIntake.astro";
---

<V2Layout>
  <header class="v2-head">
    <a class="v2-brand" href="/v2" aria-label="Greg Toler, GT Strategies">
      <GTMark height={40} />
    </a>
    <SpineNav />
    <!-- day/night parked: dark-only for now. The theme mechanism stays in the code. -->
    <a
      class="v2-linkedin"
      href="https://linkedin.com/in/gregtoler"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Greg Toler on LinkedIn"
    >
      <!-- same mark V1 uses (FluidSpineMenu.jsx), recoloured to the nav's ink -->
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
      </svg>
    </a>
  </header>

  <main>
    <!-- id lives on this wrapper: the stage keeps its own id for its scroll JS, and the
         nav needs a real #framework target spanning the whole pinned section -->
    <div id="framework">
      <HeroFramework />
    </div>

    <!-- 06 · ABOUT — V1's bio compressed to three short paragraphs; the human texture
         cut from the plane lives here instead -->
    <!-- PORTRAIT REVIEW: two treatments stacked (A: feathered portrait left, B: atmosphere
         behind). Greg is sending this to a reviewer; delete the loser and the
         .v2-optlabel spans when decided. Assets: public/images/v2/portrait-*.png,
         made by v2/build/prototypes/portrait/ (Vision segmentation + graded halo). -->
    <section class="v2-wrap v2-sec v2-about-a" id="about" aria-label="About">
      <div class="v2-about-grid">
        <div class="v2-portrait"><img src="/images/v2/portrait-feather.png" alt="Greg Toler" width="1030" height="896" loading="lazy" decoding="async" /></div>
        <div>
          <span class="v2-mono v2-aidx">About</span>
          <h2 class="v2-ah2">I build the systems that help businesses run.</h2>
          <div class="v2-abio">
            <p>I started in go-to-market operations &mdash; territory planning, pipeline, tech
            stacks, the systems and politics of getting marketing and sales working together.
            The work taught me that most operational problems aren't technology problems.
            They're design problems.</p>
            <p>That took me sideways into the operational layer: embedded COO for an agency,
            productizing service delivery, building AI systems and custom tools that replace
            expensive software.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="v2-wrap v2-sec v2-about-b" id="about-b" aria-label="About (alternate)">
      <img class="v2-atmos" src="/images/v2/portrait-atmos.png" alt="" aria-hidden="true" width="793" height="448" loading="lazy" decoding="async" />
      <div class="v2-about2">
        <div>
          <span class="v2-mono v2-aidx">About</span>
          <h2 class="v2-ah2">I build the systems that help businesses run.</h2>
          <div class="v2-abio">
            <p>I started in go-to-market operations &mdash; territory planning, pipeline, tech
            stacks, the systems and politics of getting marketing and sales working together.
            The work taught me that most operational problems aren't technology problems.
            They're design problems.</p>
            <p>That took me sideways into the operational layer: embedded COO for an agency,
            productizing service delivery, building AI systems and custom tools that replace
            expensive software.</p>
          </div>
        </div>
        <dl class="v2-astats">
          <div><dd>12+</dd><dt class="v2-mono">Years building systems</dt></div>
          <div><dd>50+</dd><dt class="v2-mono">Completed projects</dt></div>
          <div><dd>15+</dd><dt class="v2-mono">Tools &amp; agents built</dt></div>
        </dl>
      </div>
    </section>

    <!-- 05 · PROOF — monochrome logo scroll (real brands, from V1) + quote placeholders -->
    <section class="v2-wrap v2-sec v2-proof" aria-label="Proof">
      <p class="v2-mono lbl">Brands I've worked with</p>
      <div class="v2-logoscroll" aria-hidden="false">
        <div class="v2-logotrack">
          {[0,1].map((dup) => (
            <div class="v2-logoset" aria-hidden={dup === 1 ? "true" : undefined}>
              <img src="/images/brands/state-farm.svg" alt={dup ? "" : "State Farm"} />
              <img src="/images/brands/siemens.svg" alt={dup ? "" : "Siemens"} class="sm" />
              <img src="/images/brands/BambooHR_logo.svg.png" alt={dup ? "" : "BambooHR"} />
              <img src="/images/brands/certifid.svg" alt={dup ? "" : "CertifID"} />
              <img src="/images/brands/nrev.svg" alt={dup ? "" : "nrev.ai"} />
              <img src="/images/brands/medix.svg" alt={dup ? "" : "Medix"} />
              <img src="/images/brands/sayers.svg" alt={dup ? "" : "Sayers"} />
              <span class="v2-logotext">CRC Group</span>
            </div>
          ))}
        </div>
      </div>

      <!-- quotes: PLACEHOLDERS, deliberately obvious — real quotes come from Greg.
           Never invent plausible praise (CLAUDE.md: don't invent proof). -->
      <!-- QUOTES HIDDEN (Greg, reorder pass): placeholders parked until real
           quotes exist. Unhide by removing this comment wrapper.
            <div class="v2-quotes">
        <figure class="v2-quote">
          <span class="qhalo" aria-hidden="true"></span>
          <blockquote>[Quote placeholder &mdash; Greg supplies a real client quote]</blockquote>
          <figcaption class="v2-mono">[Name &middot; Role, Company]</figcaption>
        </figure>
        <figure class="v2-quote">
          <span class="qhalo" aria-hidden="true"></span>
          <blockquote>[Quote placeholder &mdash; Greg supplies a real client quote]</blockquote>
          <figcaption class="v2-mono">[Name &middot; Role, Company]</figcaption>
        </figure>
      </div>
      -->
    </section>

    <!-- 03 · APPROACH — how I do it. Three beats, not boxes (brief rule).
         Copy = V1's pillar taglines, one line each (lines-not-paragraphs rule).
         Each beat carries a case-slot comment for embedded case links later, and a
         quiet CTA that deep-links the intake pre-filled. -->
    <section class="v2-wrap v2-sec" id="approach" aria-label="Approach">
      <header class="v2-sec-head">
        <span class="v2-mono idx">Approach</span>
        <h2>Fix what's broken, build what's missing, scale what works.</h2>
      </header>
      <!-- Approach as a FLOWCHART — Greg thinks in Lucid: boxes, connectors,
           arrows, decision points. This section IS a decision tree, so it's drawn
           as one: entry diamond → three branches → converge toward contact. -->
      <div class="v2-flow">
        <div class="v2-fentry">
          <span class="fdiamond" aria-hidden="true"></span>
          <span class="v2-mono fentry-lab">Something's off</span>
        </div>
        <div class="v2-fbranch" aria-hidden="true"><i class="riser"></i><i class="rail"></i></div>
        <ol class="v2-beats">
          <li class="v2-beat">
            <i class="fdrop" aria-hidden="true"></i>
            <h3>Fix it</h3>
            <p>Something isn't working and it's costing you time, money, or both.</p>
            <p class="v2-mono btags">Leaking pipeline &middot; bloated stack &middot; manual work</p>
            <!-- case-slot: 1-2 real case links land here when written -->
            <a class="v2-beat-cta" href="#contact?situation=broken">Start here &rarr;</a>
          </li>
          <li class="v2-beat">
            <i class="fdrop" aria-hidden="true"></i>
            <h3>Build it</h3>
            <p>You have a gap and nothing off the shelf fills it.</p>
            <p class="v2-mono btags">Internal tools &middot; automation &middot; pipelines &middot; AI</p>
            <!-- case-slot -->
            <a class="v2-beat-cta" href="#contact?situation=build">Start here &rarr;</a>
          </li>
          <li class="v2-beat">
            <i class="fdrop" aria-hidden="true"></i>
            <h3>Scale it</h3>
            <p>It works today but it won't survive growth.</p>
            <p class="v2-mono btags">SOPs &middot; onboarding systems &middot; frameworks</p>
            <!-- case-slot -->
            <a class="v2-beat-cta" href="#contact?situation=scale">Start here &rarr;</a>
          </li>
        </ol>
        <div class="v2-fmerge" aria-hidden="true"><i class="rail"></i><i class="drop"></i></div>
      </div>
    </section>

    <!-- 04 · slim contact CTA band (links the single form; not a form itself) -->
    <section class="v2-wrap v2-ctaband" aria-label="Get in touch">
      <p>Sound familiar?</p>
      <a class="v2-band-link" href="#contact">Tell me what's going on &rarr;</a>
    </section>




    <!-- 07 · WORK — "more examples" index. Thin BY DESIGN until real case studies
         exist (they may end up embedded in Approach instead — decisions pending). -->
    <section class="v2-wrap v2-sec" id="work" aria-label="Selected work">
      <header class="v2-sec-head">
        <span class="v2-mono idx">Work</span>
        <h2>Selected work</h2>
      </header>
      <ul class="v2-workrows">
        <li class="v2-workrow"><span class="wdot" aria-hidden="true"></span><span class="wtitle">[Placeholder &mdash; real case study]</span><span class="v2-mono wcoord">GTM &middot; Strategy</span></li>
        <li class="v2-workrow"><span class="wdot" aria-hidden="true"></span><span class="wtitle">[Placeholder &mdash; real case study]</span><span class="v2-mono wcoord">Ops &middot; Execution</span></li>
        <li class="v2-workrow"><span class="wdot" aria-hidden="true"></span><span class="wtitle">[Placeholder &mdash; real case study]</span><span class="v2-mono wcoord">Ops &middot; Strategy + Execution</span></li>
      </ul>
      <p class="v2-worknote">Case studies are being written &mdash; each will plot back onto the map above.</p>
    </section>

    <!-- 08 · CONTACT — the single form; every contact link on the page targets this -->
    <section class="v2-wrap v2-sec" id="contact" aria-label="Contact">
      <header class="v2-sec-head center">
        <span class="v2-mono idx">Contact</span>
        <h2>Tell me what's going on.</h2>
        <p class="v2-sec-sub">Four quick steps' worth of context, then it's in my inbox.</p>
      </header>
      <ContactIntake />
    </section>
  </main>

  <footer class="v2-foot" aria-label="Site footer">
    <div class="v2-wrap v2-foot-in">
      <div class="v2-foot-brand">
        <GTMark height={26} />
        <p class="v2-foot-tag">Strategy and execution across go-to-market and operations.</p>
        <a class="v2-foot-mail" href="mailto:greg@gregtoler.com">greg@gregtoler.com</a>
      </div>
      <nav class="v2-foot-nav" aria-label="Footer">
        <a href="#framework">Framework</a>
        <a href="#about">About</a>
        <a href="#approach">Approach</a>
        <a href="#work">Work</a>
        <a href="#contact">Contact</a>
      </nav>
      <nav class="v2-foot-nav" aria-label="Legal">
        <a href="/v2/privacy">Privacy Policy</a>
        <a href="/v2/terms">Terms of Use</a>
        <a href="https://linkedin.com/in/gregtoler" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      </nav>
    </div>
    <div class="v2-wrap v2-foot-base">
      <span class="v2-mono">&copy; {new Date().getFullYear()} GT Strategies &middot; Greg Toler</span>
      <span class="v2-mono">Yes, I built this website.</span>
    </div>
  </footer>
</V2Layout>

<style>

  .v2-head {
    position: fixed; top: 0; left: 0; right: 0; z-index: 60;
    display: flex; align-items: center; justify-content: space-between;
    padding: 22px 40px;
    background: transparent;
    gap: 36px;
  }
  /* blur layer: taller than the header, faded out with a mask so there is no hard
     bottom edge where the blur stops */
  .v2-head::before {
    content: ""; position: absolute; left: 0; right: 0; top: 0;
    height: 150%;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 55%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 0%, #000 55%, transparent 100%);
    pointer-events: none;
    z-index: -1;
  }

  .v2-brand { display: flex; align-items: center; padding: 4px; position: relative; }
  /* Softened: solid shapes outshout the thin mono nav. Opacity lives on the WRAPPER —
     .v2-gtmark is scoped inside the GTMark component, so a page-scoped rule targeting
     it never matches (why earlier attempts silently did nothing). */
  .v2-brand { opacity: .72; transition: opacity .3s var(--v2-ease-out); }
  .v2-brand:hover { opacity: .95; }
  .v2-head nav { display: flex; align-items: center; gap: 26px; }
  .v2-navlink {
    font-family: var(--v2-mono); font-size: 11px; letter-spacing: .14em;
    text-transform: uppercase; color: var(--v2-ink-dim);
    transition: color .3s var(--v2-ease-out);
  }
  .v2-navlink .n { color: var(--v2-ink-faint); margin-right: 6px; }
  .v2-navlink:hover { color: var(--v2-ink); }
  .v2-navlink:hover .n { color: var(--v2-light); }

  .v2-toggle {
    font-family: var(--v2-mono); font-size: 10px; letter-spacing: .14em;
    text-transform: uppercase; color: var(--v2-ink-dim);
    background: transparent; border: 1px solid var(--v2-line);
    border-radius: 100px; padding: 7px 13px; cursor: pointer;
    transition: border-color .3s var(--v2-ease-out), color .3s var(--v2-ease-out);
  }
  .v2-toggle:hover { border-color: var(--v2-light); color: var(--v2-ink); }

  .v2-linkedin {
    display: flex; align-items: center; flex: none;
    padding: 8px;
    color: var(--v2-ink-dim);
    opacity: .65;               /* solid glyph vs thin mono nav text — needs the handicap */
    transition: color .25s var(--v2-ease-out), opacity .25s var(--v2-ease-out);
  }
  .v2-linkedin:hover { color: var(--v2-ink); opacity: .95; }

  /* Small screens: the vertical spine occupies a fixed 76px rail on the LEFT, under
     the logo — V1's sidebar layout. Content pads off it; LinkedIn sits at the rail's
     foot under a divider, exactly like the original. */
  @media (max-width: 860px) {
    main { padding-left: var(--v2-rail); }        /* V1: content margin-left 60 */
    .v2-head { padding: 16px 20px 16px 30px; }    /* V1: logo at x=34 (30 + the brand's 4px) */
    /* the rail's foot, V1's numbers: 20px glyph, 16px under a 30px divider, 24px off
       the bottom; box centred on the rail column (x=30) */
    .v2-linkedin {
      position: fixed;
      left: calc(var(--v2-rail-x) + var(--v2-rail-w) / 2 - 17px);
      bottom: calc(24px + env(safe-area-inset-bottom, 0px));
      z-index: 70;
      padding: 7px;
    }
    .v2-linkedin svg { width: 20px; height: 20px; }
    .v2-linkedin::before {
      content: ""; position: absolute;
      top: -10px; left: 50%; transform: translateX(-50%);
      width: 30px; height: 1px; background: var(--v2-line);
    }
  }

  /* ---------- shared section chrome — the hero/framework's own grammar:
       centred compositions, a glowing seam-rule, mono coordinates ---------- */
  /* Tightened rhythm (Greg): less dead air between sections so the page pulls the
     reader through — About should hand off to the brands within a viewport. */
  .v2-sec { padding-top: 72px; padding-bottom: 72px; }
  /* proof hugs About: curiosity about the person → who he's worked with, one glance */
  .v2-proof.v2-sec { padding-top: 20px; }
  /* the stacked A/B review variants share one section's worth of breathing room */
  .v2-about-a.v2-sec { padding-bottom: 28px; }
  .v2-about-b.v2-sec { padding-top: 28px; padding-bottom: 32px; }
  /* …but the MAIN section boundaries breathe more (Greg): About+brands stay one unit,
     with real distance before Approach, before Work, and before Contact. */
  #approach.v2-sec { padding-top: 128px; }
  /* HORIZONTAL-SCROLL FIX: the Option B atmosphere portrait is a fixed-width image
     behind the text; below ~890px it bled past the viewport and scrolled the whole
     page sideways. Clip it to its own section (art direction preserved, bleed gone). */
  .v2-about-b { overflow: hidden; }
  #work.v2-sec { padding-top: 128px; }
  #contact.v2-sec { padding-top: 128px; }
  /* Sections sit in the framework's centred column (--v2-measure, 880px), not the full
     1440 wrap — the hero/plane are ~800px centred and Greg wants the rest to match.
     .v2-wrap is content-box, so its 32px side padding sits outside this. KEEP. */
  .v2-sec, .v2-ctaband { max-width: var(--v2-measure); }
  .v2-sec-head { margin-bottom: 56px; text-align: center; }
  .v2-sec-head .idx { color: var(--v2-light); display: block; margin-bottom: 12px; }
  .v2-sec-head h2 {
    font-family: var(--v2-display); font-weight: 600;
    font-size: clamp(1.7rem, 3.4vw, 2.7rem); line-height: 1.1;
    margin: 0 auto; color: var(--v2-ink); max-width: 24ch;
  }
  /* the seam, quoted: a centred glowing rule under every section title */
  .v2-sec-head::after {
    content: ""; display: block;
    width: 140px; height: 1px; margin: 26px auto 0;
    background: var(--v2-light);
    box-shadow: 0 0 6px 0 var(--v2-light-soft), 0 0 22px 2px var(--v2-light-soft);
  }
  .v2-sec-sub { color: var(--v2-ink-dim); margin: 16px 0 0; font-size: 15px; }

  /* ---------- 03 approach: a drawn decision tree (Lucid grammar) ----------
     Diagram primitives — reuse these for future process visuals:
     .fdiamond (decision), .v2-beat (process box), .riser/.rail/.fdrop/.drop
     (connectors), arrowheads via border triangles. Same stroke + glow as the axes. */
  .v2-flow { position: relative; }

  .v2-fentry { text-align: center; position: relative; padding-bottom: 6px; }
  .v2-fentry .fdiamond {
    display: block; width: 12px; height: 12px; margin: 0 auto 12px;
    background: var(--v2-base);
    border: 1px solid var(--v2-light); transform: rotate(45deg);
    box-shadow: 0 0 6px 0 var(--v2-light-soft), 0 0 18px 2px var(--v2-light-soft);
  }
  .v2-fentry .fentry-lab { color: var(--v2-ink-dim); }

  /* branch: riser from the diamond, distribution rail, drops into each box */
  .v2-fbranch { position: relative; height: 56px; max-width: 66.6%; margin: 0 auto; }
  .v2-fbranch .riser {
    position: absolute; left: 50%; top: -6px; height: 30px; width: 1px;
    transform: translateX(-50%);
    background: var(--v2-light); opacity: .55;
    box-shadow: 0 0 6px 0 var(--v2-light-soft);
  }
  .v2-fbranch .rail {
    position: absolute; left: 0; right: 0; top: 24px; height: 1px;
    background: var(--v2-light); opacity: .55;
    box-shadow: 0 0 6px 0 var(--v2-light-soft);
  }
  /* the three drops + arrowheads live on the boxes themselves */
  .v2-beat .fdrop {
    position: absolute; left: 50%; top: -32px; height: 26px; width: 1px;
    transform: translateX(-50%);
    background: var(--v2-light); opacity: .55;
    box-shadow: 0 0 6px 0 var(--v2-light-soft);
  }
  .v2-beat .fdrop::after {
    content: ""; position: absolute; left: 50%; bottom: -1px;
    transform: translate(-50%, 100%);
    border-left: 3.5px solid transparent; border-right: 3.5px solid transparent;
    border-top: 6px solid var(--v2-light); opacity: .8;
  }

  /* process boxes: hairline, 2px radius (the token), glass — Lucid shapes in
     the site's material */
  .v2-beats {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px;
  }
  .v2-beat {
    position: relative; text-align: center;
    border: 1px solid var(--v2-line); border-radius: var(--v2-radius);
    background: color-mix(in srgb, var(--v2-surface) 72%, transparent);
    padding: 30px 22px 26px;
    transition: border-color .35s var(--v2-ease-out), transform .35s var(--v2-ease-out);
  }
  .v2-beat:hover { border-color: color-mix(in srgb, var(--v2-light) 55%, var(--v2-line)); transform: translateY(-3px); }
  .v2-beat h3 {
    font-family: var(--v2-display); font-weight: 600;
    font-size: clamp(1.25rem, 2.2vw, 1.6rem); margin: 0 0 10px; color: var(--v2-ink);
  }
  .v2-beat p { color: var(--v2-ink-dim); margin: 0; font-size: 14px; line-height: 1.55; }
  .v2-beat .btags { color: var(--v2-ink-faint); margin-top: 12px; letter-spacing: .1em; font-size: 9px; }
  .v2-beat-cta {
    display: inline-block; margin-top: 16px;
    font-family: var(--v2-mono); font-size: 10.5px; letter-spacing: .12em;
    text-transform: uppercase; color: var(--v2-ink-dim);
    transition: color .25s var(--v2-ease-out);
  }
  .v2-beat-cta:hover { color: var(--v2-light); }

  /* merge: rail under the boxes, single drop + arrowhead pointing at the CTA band */
  .v2-fmerge { position: relative; height: 58px; max-width: 66.6%; margin: 0 auto; }
  .v2-fmerge .rail {
    position: absolute; left: 0; right: 0; top: 26px; height: 1px;
    background: var(--v2-light); opacity: .4;
    box-shadow: 0 0 6px 0 var(--v2-light-soft);
  }
  .v2-fmerge .drop {
    position: absolute; left: 50%; top: 26px; height: 26px; width: 1px;
    transform: translateX(-50%);
    background: var(--v2-light); opacity: .55;
  }
  .v2-fmerge .drop::after {
    content: ""; position: absolute; left: 50%; bottom: -1px;
    transform: translate(-50%, 100%);
    border-left: 3.5px solid transparent; border-right: 3.5px solid transparent;
    border-top: 6px solid var(--v2-light); opacity: .8;
  }

  /* ---------- 04 slim CTA band: centred, like the hero's scroll cue ---------- */
  .v2-ctaband {
    display: flex; flex-direction: column; align-items: center; gap: 16px;
    text-align: center; padding-top: 0; padding-bottom: 10px;
  }
  .v2-ctaband p { font-family: var(--v2-display); font-weight: 600; font-size: clamp(1.2rem, 2.2vw, 1.7rem); color: var(--v2-ink-dim); margin: 0; }
  /* the merge arrow must land ON the band — kill the inter-section gap */
  #approach.v2-sec { padding-bottom: 0; }

  /* terminator node: the flow's arrows land on this pill */
  .v2-band-link {
    font-family: var(--v2-mono); font-size: 12px; letter-spacing: .12em;
    text-transform: uppercase; color: var(--v2-light);
    border: 1px solid var(--v2-line); border-radius: 100px;
    padding: 12px 22px;
