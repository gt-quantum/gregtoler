<script>
  // ---- Approach: bezier connectors + scroll-linked draw + comets. Work: tracing beam ----
  (() => {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const clamp = (v: number, a: number, b: number) => (v < a ? a : v > b ? b : v);
    const seg = (p: number, a: number, b: number) => clamp((p - a) / (b - a), 0, 1);
    const ease = (t: number) => 1 - Math.pow(1 - t, 3);
    const NS = "http://www.w3.org/2000/svg";

    const flow = document.getElementById("v2-flow");
    if (flow) {
      const svg = flow.querySelector<SVGSVGElement>(".v2-flowsvg")!;
      const gBase = svg.querySelector<SVGGElement>(".fbase")!;
      const gBeam = svg.querySelector<SVGGElement>(".fbeams")!;
      const entry = flow.querySelector<HTMLElement>(".v2-fentry .fnode")!;
      const beats = Array.from(flow.querySelectorAll<HTMLElement>(".v2-beat"));
      const nodes = beats.map((b) => b.querySelector<HTMLElement>(".fnode")!);
      const exit = flow.querySelector<HTMLElement>(".v2-fexit .fnode")!;
      type Link = { el: SVGPathElement; len: number; a: number; b: number };
      let links: Link[] = [];

      const curve = (x1: number, y1: number, x2: number, y2: number, phone: boolean) =>
        phone
          ? `M${x1} ${y1} C${x1} ${(y1 + y2) / 2}, ${x1} ${y2}, ${x2} ${y2}`             // down, then sweep right into the card
          : `M${x1} ${y1} C${x1} ${(y1 + y2) / 2}, ${x2} ${(y1 + y2) / 2}, ${x2} ${y2}`; // S-curve, Magic-UI style

      function build() {
        const fr = flow!.getBoundingClientRect();
        const R = (el: HTMLElement) => { const r = el.getBoundingClientRect(); return { l: r.left - fr.left, t: r.top - fr.top, r: r.right - fr.left, b: r.bottom - fr.top, cx: r.left - fr.left + r.width / 2, cy: r.top - fr.top + r.height / 2 }; };
        const phone = window.matchMedia("(max-width: 768px)").matches;
        const e = R(entry), x = R(exit);
        gBase.innerHTML = ""; gBeam.innerHTML = ""; links = [];
        const ds: { d: string; a: number; b: number }[] = [];
        // entry → each card (stagger), each card → exit (later)
        beats.forEach((bt, i) => {
          const br = R(bt), nr = R(nodes[i]);
          ds.push(phone
            ? { d: curve(e.cx, e.b, br.l, nr.cy, true), a: 0.02 + i * 0.14, b: 0.42 + i * 0.14 }
            : { d: curve(e.cx, e.b, nr.cx, nr.t, false), a: 0.02 + i * 0.1, b: 0.46 + i * 0.1 });
        });
        beats.forEach((bt, i) => {
          const br = R(bt), nr = R(nodes[i]);
          ds.push(phone
            ? { d: `M${br.l} ${br.b - 26} C${x.cx} ${br.b - 26}, ${x.cx} ${br.b}, ${x.cx} ${Math.min(x.t, br.b + 60)} V${x.t}`, a: 0.5 + i * 0.1, b: 0.9 + i * 0.05 }
            : { d: curve(nr.cx, br.b, x.cx, x.t, false), a: 0.5 + i * 0.1, b: 0.92 + i * 0.04 });
        });
        svg.setAttribute("viewBox", `0 0 ${fr.width} ${fr.height}`);
        ds.forEach(({ d, a, b }, i) => {
          const base = document.createElementNS(NS, "path"); base.setAttribute("d", d); gBase.appendChild(base);
          const len = base.getTotalLength();
          base.style.setProperty("--len", String(len));
          links.push({ el: base, len, a, b });
          const k = Math.min(90, len * 0.45);
          for (const cls of ["halo", "core"]) {
            const p = document.createElementNS(NS, "path"); p.setAttribute("d", d); p.setAttribute("class", cls);
            p.style.strokeDasharray = `${k} ${len + 200}`;
            p.style.setProperty("--k", String(k)); p.style.setProperty("--len", String(len));
            p.style.setProperty("--dur", `${(2.6 + len / 400).toFixed(2)}s`);
            p.style.setProperty("--delay", `${(i < beats.length ? i * 0.55 : 1.8 + (i - beats.length) * 0.55).toFixed(2)}s`);
            gBeam.appendChild(p);
          }
        });
        render(true);
      }

      // scroll-linked progress with inertia: target from the section's position, eased toward
      let target = 0, cur = 0, raf = 0, live = false;
      function progressTarget() {
        const r = flow!.getBoundingClientRect(), vh = window.innerHeight;
        return clamp((vh * 0.88 - r.top) / (Math.min(r.height, vh * 0.9) * 0.9), 0, 1);
      }
      function render(force = false) {
        cur = force ? target : cur + (target - cur) * 0.11;
        if (Math.abs(target - cur) < 0.0015) cur = target;
        links.forEach((l) => { l.el.style.strokeDashoffset = String(l.len * (1 - ease(seg(cur, l.a, l.b)))); });
        beats.forEach((b, i) => b.style.setProperty("--p", ease(seg(cur, 0.28 + i * 0.1, 0.5 + i * 0.1)).toFixed(3)));
        exit.style.setProperty("--p", ease(seg(cur, 0.82, 1)).toFixed(3));
        const nowLive = cur >= 0.985;
        if (nowLive !== live) { live = nowLive; flow!.classList.toggle("is-live", live); }
        if (cur !== target) raf = requestAnimationFrame(() => render()); else raf = 0;
      }
      const kick = () => { target = reduce ? 1 : progressTarget(); if (!raf) raf = requestAnimationFrame(() => render(reduce)); };

      flow.classList.add("is-ready");
      build();
      window.addEventListener("scroll", kick, { passive: true });
      let t: number | undefined;
      window.addEventListener("resize", () => { window.clearTimeout(t); t = window.setTimeout(() => { build(); kick(); }, 120); });
      document.fonts?.ready.then(() => { build(); kick(); });
      kick();
    }

    // Work: a beam traces down the plot-dots as you scroll; rows light as it passes
    const wrap = document.getElementById("v2-workwrap");
    if (wrap) {
      const rows = Array.from(wrap.querySelectorAll<HTMLElement>(".v2-workrow"));
      const trace = wrap.querySelector<HTMLElement>(".v2-worktrace")!;
      let target = 0, cur = 0, raf = 0;
      function tick() {
        cur += (target - cur) * 0.12; if (Math.abs(target - cur) < 0.002) cur = target;
        trace.style.setProperty("--p", cur.toFixed(4));
        const wr = wrap!.getBoundingClientRect();
        rows.forEach((r) => { const rr = r.getBoundingClientRect(); r.classList.toggle("lit", (rr.top + rr.height * 0.5 - wr.top) / wr.height <= cur + 0.02); });
        if (cur !== target) raf = requestAnimationFrame(tick); else raf = 0;
      }
      const kick = () => {
        const r = wrap!.getBoundingClientRect(), vh = window.innerHeight;
        target = reduce ? 1 : clamp((vh * 0.8 - r.top) / (r.height + vh * 0.25), 0, 1);
        if (!raf) raf = requestAnimationFrame(tick);
      };
      wrap.classList.add("is-ready");
      window.addEventListener("scroll", kick, { passive: true });
      window.addEventListener("resize", kick);
      kick();
    }
  })();

  // dark-only: clear any stored day preference so nobody is stuck in the parked theme
  document.documentElement.removeAttribute("data-v2-theme");
  try { localStorage.removeItem("v2-theme"); } catch (e) {}

  // accent audition retired — clear any stored pick so the locked token wins
  try { localStorage.removeItem("v2-accent"); } catch (e) {}
</script>
